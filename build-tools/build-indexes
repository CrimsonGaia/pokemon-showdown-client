function es3stringify(obj) {
  if (!obj) return 'null';
  const buf = JSON.stringify(obj);
  if (!buf) return 'null';
  return buf.replace(
    /"([A-Za-z][A-Za-z0-9]*)":/g,
    (fullMatch, key) =>
      (['return', 'new', 'delete'].includes(key) ? fullMatch : `${key}:`)
  );
}
function requireNoCache(...args) {
  const pathSpec =
    args.length === 1 ? args[0] : path.join(args[0], args[1]);

  delete require.cache[require.resolve(pathSpec)];
  return require(pathSpec);
}

