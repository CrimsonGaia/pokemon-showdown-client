function ensureDir(dir) {
  fs.mkdirSync(dir, {recursive: true});
}

function pickExport(mod, keys) {
  for (const k of keys) {
    if (mod && mod[k] && typeof mod[k] === 'object') return mod[k];
  }
  return null;
}

function requireServer(relPath) {
  return requireNoCache(path.join(SERVER_PATH, relPath));
}

function writeBattleExport(outPath, exportName, data) {
  if (!data || typeof data !== 'object') {
    throw new Error(`Refusing to write ${outPath}: export ${exportName} is not an object`);
  }
  const buf = `exports.${exportName} = ` + es3stringify(data) + ';';
  if (!buf || buf.includes('undefined')) {
    throw new Error(`Serialization failed for ${outPath} (${exportName})`);
  }
  ensureDir(path.dirname(outPath));
  fs.writeFileSync(outPath, buf);
}
function writeBattleModData(outPath, modid, key, data) {
  if (!data || typeof data !== 'object') {
    throw new Error(`Refusing to write ${outPath}: mod export ${modid}.${key} is not an object`);
  }
  const buf =
    `exports.BattleModData = exports.BattleModData || Object.create(null);\n` +
    `exports.BattleModData['${modid}'] = exports.BattleModData['${modid}'] || Object.create(null);\n` +
    `exports.BattleModData['${modid}']['${key}'] = ` + es3stringify(data) + `;\n`;

  if (!buf || buf.includes('undefined')) {
    throw new Error(`Serialization failed for ${outPath} (BattleModData['${modid}']['${key}'])`);
  }
  ensureDir(path.dirname(outPath));
  fs.writeFileSync(outPath, buf);
}

function cloneObjTable(src) {
  const out = {};
  for (const id in src) out[id] = {...src[id]};
  return out;
}

/**
 * Build a "patch" table for a mod: includes
 * - brand new entries (not in base)
 * - entries whose selected keys differ (or full compare if keys=null)
 */
function buildPatchTable(baseTable, modTable, keys = null) {
  const patch = {};
  for (const id in modTable) {
    const m = modTable[id];
    const b = baseTable[id];
    if (!b) { patch[id] = {...m}; continue; }

    if (!keys) {
      if (JSON.stringify(m) !== JSON.stringify(b)) patch[id] = {...m};
      continue;
    }

    let changed = false;
    const diff = {};
    for (const k of keys) {
      if (JSON.stringify(m[k]) !== JSON.stringify(b[k])) {
        diff[k] = m[k];
        changed = true;
      }
    }
    if (changed) patch[id] = diff;
  }
  return patch;
}

