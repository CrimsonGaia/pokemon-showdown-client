function loadModData(relPath, kind) {
  let mod;
  try {
    mod = requireServer(relPath);
  } catch {
    return null;
  }

  if (!mod) return null;

  switch (kind) {
    case 'abilities':
      return mod.BattleAbilities || mod.Abilities || mod.default || null;

    case 'abilitiesText':
      return mod.AbilitiesText || mod.default || mod || null;

    case 'moves':
      return mod.BattleMovedex || mod.Moves || mod.default || null;

    case 'movesText':
      return mod.MovesText || mod.default || mod || null;

    default:
      throw new Error(`Unknown mod data kind: ${kind}`);
  }
}







