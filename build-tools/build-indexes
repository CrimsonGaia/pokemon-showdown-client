process.stdout.write("Building `data/pokedex.js` (base) + mod overlay... ");
{
  // -------------------------
  // BASE (VANILLA) POKEDEX
  // -------------------------
  const serverPokedexModule = requireServer('dist/data/pokedex.js');
  const basePokedex = pickExport(serverPokedexModule, ['BattlePokedex', 'Pokedex', 'default']);
  if (!basePokedex) throw new Error('Server dist/data/pokedex.js did not export Pokedex/BattlePokedex');

  const Pokedex = cloneObjTable(basePokedex);

  // Preserve the client behavior: merge tiers/nonstandard from base FormatsData
  // (your client expects tier/isNonstandard/unreleasedHidden on BattlePokedex entries)
  for (const id in Pokedex) {
    const entry = Pokedex[id];
    if (Dex.data.FormatsData[id]) {
      const fd = Dex.data.FormatsData[id];
      if (fd.tier) entry.tier = fd.tier;
      if (fd.isNonstandard) entry.isNonstandard = fd.isNonstandard;
      if (fd.unreleasedHidden) entry.unreleasedHidden = fd.unreleasedHidden;
    }
  }

  writeBattleExport(path.join(CLIENT_DATA_DIR, 'pokedex.js'), 'BattlePokedex', Pokedex);
  fs.writeFileSync(path.join(CLIENT_DATA_DIR, 'pokedex.json'), JSON.stringify(Pokedex));

  // -------------------------
  // MOD OVERLAY (PATCH)
  // -------------------------
  const baseDex = Dex.mod('gen9');
  const modDex = Dex.mod(MOD_ID);

  // Create a patch that contains:
  // - new mons: full entry
  // - existing mons: only keys that differ
  // plus tier/isNonstandard/unreleasedHidden diffs from FormatsData
  const patch = {};

  const patchKeys = [
    'abilities', 'baseStats', 'types', 'weightkg',
    'isNonstandard', 'requiredItems', 'formeOrder',
  ];

  for (const id in modDex.data.Pokedex) {
    const modSpecies = modDex.species.get(id);
    const baseSpecies = baseDex.species.get(id);

    if (!baseSpecies?.exists) {
      patch[id] = {...modSpecies};
      continue;
    }

    const diff = {};
    for (const k of patchKeys) {
      if (JSON.stringify(modSpecies[k]) !== JSON.stringify(baseSpecies[k])) diff[k] = modSpecies[k];
    }

    // FormatsData-based tier/nonstandard overrides
    const baseFD = baseDex.data.FormatsData?.[id] || null;
    const modFD = modDex.data.FormatsData?.[id] || null;
    if (modFD) {
      if (!baseFD || modFD.tier !== baseFD.tier) diff.tier = modFD.tier;
      if (!baseFD || modFD.isNonstandard !== baseFD.isNonstandard) diff.isNonstandard = modFD.isNonstandard;
      if (!baseFD || modFD.unreleasedHidden !== baseFD.unreleasedHidden) diff.unreleasedHidden = modFD.unreleasedHidden;
    }

    if (Object.keys(diff).length) patch[id] = diff;
  }

  	ensureDir(MOD_OUT_DIR);
 	writeBattleModData(path.join(MOD_OUT_DIR, 'pokedex.js'), MOD_ID, 'Pokedex', patch);
  	fs.writeFileSync(path.join(MOD_OUT_DIR, 'pokedex.json'), JSON.stringify(patch));

  console.log(`Built ${Object.keys(patch).length} ${MOD_ID} pokedex overlay entries`);
}
