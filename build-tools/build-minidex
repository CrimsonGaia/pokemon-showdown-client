#!/usr/bin/env node
'use strict';
const fs = require("fs");
const path = require("path");
process.chdir(path.resolve(__dirname, '../play.pokemonshowdown.com'));
const imageSize = require('image-size');
// ---- local server dex loader (no caches/) ----
const repoRoot = path.resolve(__dirname, '..'); // pokemon-showdown-client repo root
const SERVER_PATH = process.env.PS_SERVER_PATH
  ? path.resolve(process.env.PS_SERVER_PATH)
  : (
      fs.existsSync(path.resolve(repoRoot, '..', 'pokemon-showdown'))
        ? path.resolve(repoRoot, '..', 'pokemon-showdown')
        : path.resolve(repoRoot, 'pokemon-showdown')
    );
if (
  !fs.existsSync(path.join(SERVER_PATH, 'dist', 'sim', 'dex.js')) &&
  !fs.existsSync(path.join(SERVER_PATH, 'dist', 'sim', 'dex'))
) {
  throw new Error(
    `pokemon-showdown server dist not found at: ${path.join(SERVER_PATH, 'dist')}\n` +
    `Build the server first or set PS_SERVER_PATH.`
  );
}
let Dex;
try { Dex = require(path.join(SERVER_PATH, 'dist', 'sim', 'dex')).Dex; }
catch { Dex = require(path.join(SERVER_PATH, 'dist', 'sim', 'dex.js')).Dex; }
const toID = Dex.toID;

// Persistent cache of sprite dimensions, keyed by (mtime, size) of the source gif.
// imageSize() has to actually read each file's header, and there are 8 lookups per
// forme (ani/ani-back/gen5ani/gen5ani-back x normal/female) across every species and
// cosmetic forme - this is the slow part of the whole build, and dimensions never
// change unless the file itself does, so a cache is a straightforward win.
const CACHE_DIR = path.resolve(repoRoot, '.build-cache');
const CACHE_FILE = path.resolve(CACHE_DIR, 'minidex-sizes.json');
let sizeCache = {};
try { sizeCache = JSON.parse(fs.readFileSync(CACHE_FILE, 'utf8')); } catch {}
let cacheHits = 0, cacheMisses = 0;

function ensureDir(dir) { fs.mkdirSync(dir, {recursive: true}); }

process.stdout.write("Updating animated sprite dimensions... ");
let buf = `/*
DO NOT EDIT

THIS FILE IS AUTOGENERATED BY ./build-tools/build-minidex
*/
exports.BattlePokemonSprites = {
	substitute:{exists:false, front:{w:34, h:39}, back:{w:37, h:38}},
`;
let g5buf = `/*
DO NOT EDIT

THIS FILE IS AUTOGENERATED BY ./build-tools/build-minidex
*/
exports.BattlePokemonSpritesBW = {
`;
function sizeObj(objPath) {
	const stat = (() => { try { return fs.statSync(objPath); } catch { return null; } })();
	if (!stat) return undefined;

	const cached = sizeCache[objPath];
	if (cached && cached.mtimeMs === stat.mtimeMs && cached.size === stat.size) {
		cacheHits++;
		return cached.dims;
	}

	cacheMisses++;
	try {
		const size = imageSize(objPath);
		const dims = { w: size.width, h: size.height };
		sizeCache[objPath] = { mtimeMs: stat.mtimeMs, size: stat.size, dims };
		return dims;
	} catch {
		return undefined;
	}
}
function updateSizes() {
	const speciesIds = Object.keys(Dex.data.Pokedex);
	const total = speciesIds.length;
	let processed = 0;
	let lastProgressLog = Date.now();

	for (const baseid of speciesIds) {
		const species = Dex.species.get(baseid);
		for (const formeName of [''].concat(species.cosmeticFormes || [])) {
			let spriteid = species.spriteid;
			if (formeName) spriteid += '-' + toID(formeName).slice(species.id.length);
			const id = toID(spriteid);
			{
				const row = { num: species.num };
				const frontSize = sizeObj('sprites/ani/' + spriteid + '.gif');
				if (frontSize) row.front = frontSize;
				const frontSizeF = sizeObj('sprites/ani/' + spriteid + '-f.gif');
				if (frontSizeF) row.frontf = frontSizeF;
				const backSize = sizeObj('sprites/ani-back/' + spriteid + '.gif');
				if (backSize) row.back = backSize;
				const backSizeF = sizeObj('sprites/ani-back/' + spriteid + '-f.gif');
				if (backSizeF) row.backf = backSizeF;
				if (row.front || row.back || !row.forme) { buf += `\t${id}:` + JSON.stringify(row).replace(/"/g, '') + `,\n`; }
			}
			{
				const g5row = { num: species.num };
				const frontSize = sizeObj('sprites/gen5ani/' + spriteid + '.gif');
				if (frontSize) g5row.front = frontSize;
				const frontSizeF = sizeObj('sprites/gen5ani/' + spriteid + '-f.gif');
				if (frontSizeF) g5row.frontf = frontSizeF;
				const backSize = sizeObj('sprites/gen5ani-back/' + spriteid + '.gif');
				if (backSize) g5row.back = backSize;
				const backSizeF = sizeObj('sprites/gen5ani-back/' + spriteid + '-f.gif');
				if (backSizeF) g5row.backf = backSizeF;
				if (g5row.front || g5row.back || !g5row.forme) { g5buf += `\t${id}:` + JSON.stringify(g5row).replace(/"/g, '') + `,\n`; }
			}
		}
		processed++;
		const now = Date.now();
		if (now - lastProgressLog > 2000) {
			console.log(`\n  ...${processed}/${total} species (${Math.floor((processed / total) * 100)}%), ${cacheHits} cached / ${cacheMisses} read so far`);
			lastProgressLog = now;
		}
	}
	buf = buf.slice(0, -2) + `
};
`;
	g5buf = g5buf.slice(0, -2) + `
};
`;
	fs.writeFileSync('data/pokedex-mini.js', buf);
	fs.writeFileSync('data/pokedex-mini-bw.js', g5buf);
}
if (fs.existsSync('sprites/ani/')) {
	updateSizes();
	ensureDir(CACHE_DIR);
	fs.writeFileSync(CACHE_FILE, JSON.stringify(sizeCache));
	console.log(`DONE (${cacheHits} cached, ${cacheMisses} read from disk)`);
} else {
	try {
		fs.unlinkSync('data/pokedex-mini.js');
		fs.unlinkSync('data/pokedex-mini-bw.js');
	} catch {}
	console.log('SKIPPED');
}
