{
  "extends": [
    "development"
  ],
  "hints": {
    "no-protocol-relative-urls": "off",
    "apple-touch-icons": "off",
    "axe/name-role-value": "off",
    "axe/language": "off",
    "no-inline-styles": "off",
    "disown-opener": "off",
    "axe/forms": [
      "default",
      {
        "label": "off",
        "select-name": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "image-rendering: -moz-crisp-edges",
          "-webkit-overflow-scrolling",
          "min-height: auto",
          "scrollbar-width",
          "scrollbar-width: none"
        ]
      }
    ],
    "css-prefix-order": "off",
    "meta-viewport": "off",
    "axe/text-alternatives": [
      "default",
      {
        "document-title": "off"
      }
    ],
    "axe/aria": [
      "default",
      {
        "aria-valid-attr-value": "off",
        "aria-roles": "off",
        "aria-required-children": "off"
      }
    ]
  }
}